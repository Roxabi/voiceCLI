[Unit]
Description=voiceCLI STT NATS worker
After=voicecli-nats.service
Requires=voicecli-nats.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Container]
Image=ghcr.io/roxabi/voicecli:0.5.0
ContainerName=voicecli-stt
Network=voicecli.network
Volume=voicecli-models:/home/appuser/.cache/huggingface
Volume=voicecli-models:/home/appuser/.cache/voicecli
Secret=voicecli-nats-stt,type=mount,target=/home/appuser/.config/voicecli/nkeys/seed.seed,mode=0400
Device=nvidia.com/gpu=all
# Intra-network NATS — voicecli-nats.container hostname resolves via voicecli.network.
# Phase 4: switch to nats://lyra-nats:4222 when consolidating on shared NATS (ADR-055 D2).
Environment=NATS_URL=nats://voicecli-nats:4222
HealthCmd=bash -c "nvidia-smi && pgrep -f 'voicecli nats-serve' || exit 1"
HealthInterval=30s
NoNewPrivileges=true
DropCapability=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SYS_PTRACE

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
