{
  "pythonVersion": "3.12",
  "pythonPlatform": "Linux",
  "typeCheckingMode": "basic",
  "include": ["src/voicecli"],
  "exclude": [
    "src/voicecli/__pycache__"
  ],
  "ignore": [
    "src/voicecli/engines",
    "src/voicecli/ui/overlay.py",
    "src/voicecli/ui/overlay_draw.py",
    "src/voicecli/ui/overlay_audio.py",
    "src/voicecli/adapters/nats",
    "src/voicecli/runtime/wire_protocol.py",
    "src/voicecli/adapters/nats/transcribe_client.py",
    "src/voicecli/runtime/daemon.py",
    "src/voicecli/runtime/listen.py",
    "src/voicecli/runtime/model_registry.py",
    "src/voicecli/core/models.py",
    "src/voicecli/runtime/transcribe_daemon.py",
    "src/voicecli/runtime/transcribe.py",
    "src/voicecli/runtime/dictation.py",
    "src/voicecli/runtime/recording.py",
    "src/voicecli/cli/doctor.py"
  ],
  "reportMissingImports": "error",
  "reportMissingModuleSource": "none"
}
