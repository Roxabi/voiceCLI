{
  "pythonVersion": "3.12",
  "pythonPlatform": "Linux",
  "typeCheckingMode": "basic",
  "include": ["src/voicecli"],
  "exclude": [
    "src/voicecli/__pycache__"
  ],
  "ignore": [
    "src/voicecli/engines",
    "src/voicecli/overlay.py",
    "src/voicecli/overlay_draw.py",
    "src/voicecli/overlay_audio.py",
    "src/voicecli/nats",
    "src/voicecli/daemon.py",
    "src/voicecli/engine.py",
    "src/voicecli/listen.py",
    "src/voicecli/model_registry.py",
    "src/voicecli/models.py",
    "src/voicecli/stt_daemon.py",
    "src/voicecli/transcribe.py",
    "src/voicecli/cli_doctor.py"
  ],
  "reportMissingImports": "error",
  "reportMissingModuleSource": "none"
}
