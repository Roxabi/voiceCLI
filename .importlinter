[importlinter]
root_packages =
    voicecli
include_external_packages = False

# ── Contracts ────────────────────────────────────────────────────────────────

[importlinter:contract:layer-boundaries]
name = Layer dependency rule
type = layers
layers =
    voicecli.cli
    voicecli.api
    voicecli.ui
    voicecli.adapters
    voicecli.runtime
    voicecli.engines
    voicecli.ports
    voicecli.core
ignore_imports =
    # Tracked: engines import voicecli.api.markdown for Segment type — upward coupling.
    # Fix: move Segment to voicecli.core. See #168.
    voicecli.engines.chatterbox -> voicecli.api.markdown
    voicecli.engines.chatterbox_turbo -> voicecli.api.markdown
    voicecli.engines.qwen -> voicecli.api.markdown
    voicecli.engines.qwen_fast -> voicecli.api.markdown
    voicecli.engines.voxtral -> voicecli.api.markdown
    # Tracked: wire_protocol imports voicecli.api.markdown for Segment type. See #168.
    voicecli.runtime.wire_protocol -> voicecli.api.markdown
    # Tracked: adapters import voicecli.api directly — should go via voicecli.ports. See #168.
    voicecli.adapters.nats.tts_adapter -> voicecli.api
    voicecli.adapters.nats.stt_adapter -> voicecli.api
    # Tracked: stt_daemon plays sounds and copies to clipboard via ui layer. See #168.
    voicecli.runtime.stt_daemon -> voicecli.ui.sounds
    voicecli.runtime.stt_daemon -> voicecli.ui.clipboard
    # Tracked: ports.stt imports runtime.transcribe directly instead of via port abstraction. See #168.
    voicecli.ports.stt -> voicecli.runtime.transcribe

[importlinter:contract:api-no-direct-infra]
name = api must not import runtime daemon or model_registry directly
type = forbidden
source_modules = voicecli.api
forbidden_modules =
    voicecli.runtime.daemon
    voicecli.runtime.stt_daemon
    voicecli.runtime.model_registry
allow_indirect_imports = True
ignore_imports =
    # Tracked: api.api calls runtime.daemon socket for Qwen requests. See #168.
    voicecli.api.api -> voicecli.runtime.daemon
    # Tracked: api.api calls runtime.model_registry for VRAM management. See #168.
    voicecli.api.api -> voicecli.runtime.model_registry
