[importlinter]
root_packages =
    voicecli
include_external_packages = False

# ── Contracts ────────────────────────────────────────────────────────────────

[importlinter:contract:layer-boundaries]
name = Layer dependency rule
type = layers
layers =
    voicecli.cli | voicecli.cli_samples | voicecli.cli_dictate | voicecli.cli_doctor | voicecli.cli_nats | voicecli.tg | voicecli.listen | voicecli.overlay | voicecli.stt_client | voicecli.overlay_audio | voicecli.overlay_draw
    voicecli.api
    voicecli.adapters
    voicecli.engine | voicecli.transcribe | voicecli.daemon | voicecli.stt_daemon | voicecli.model_registry | voicecli.daemon_protocol
    voicecli.config | voicecli.paths | voicecli.utils | voicecli.env | voicecli.models | voicecli.samples | voicecli.stt_modes | voicecli.clipboard | voicecli.history | voicecli.ui_sounds
ignore_imports =
    # Transitional: voicecli.api.translate imports voicecli.api.markdown for MD rendering — same api package peer dependency
    voicecli.api.translate -> voicecli.api.markdown
    # Transitional: voicecli.api.translate imports voicecli.utils for shared utilities — cross-layer utility dependency
    voicecli.api.translate -> voicecli.utils
    # Transitional: voicecli.cli assembler imports extracted sub-app modules — same top-tier peer dependencies (ADR-003 V9)
    voicecli.cli -> voicecli.cli_samples
    voicecli.cli -> voicecli.cli_dictate
    voicecli.cli -> voicecli.cli_doctor
    voicecli.cli -> voicecli.cli_nats
    # Transitional: voicecli.cli_nats imports voicecli.adapters.nats adapters and config — same top-tier peer dependencies (ADR-003 V9)
    voicecli.cli_nats -> voicecli.adapters.nats.config
    voicecli.cli_nats -> voicecli.adapters.nats.tts_adapter
    voicecli.cli_nats -> voicecli.adapters.nats.stt_adapter
    # Transitional: voicecli.cli_nats configures model_registry at startup — pending ports-layer wiring (ADR-003)
    voicecli.cli_nats -> voicecli.model_registry
    # Transitional: voicecli.cli imports voicecli.listen for recording subcommand — needs extraction to adapter layer
    voicecli.cli -> voicecli.listen
    # Transitional: voicecli.daemon imports voicecli.engine to load TTS engines — daemon is an infrastructure adapter, coupling is expected but needs SynthesisPort wiring (ADR-003)
    voicecli.daemon -> voicecli.engine
    # Transitional: daemon_protocol is a private helper of daemon — same infrastructure layer, peer import acceptable
    voicecli.daemon -> voicecli.daemon_protocol
    # Transitional: daemon_protocol directly loads engines — covered by the same SynthesisPort ADR-003 wiring work as daemon
    voicecli.daemon_protocol -> voicecli.engine
    # Transitional: daemon_protocol is shared wire-encoding between TTS/STT daemons (audit #162). Per ADR-003 debt #4, extract to voicecli.wire_protocol under the ports layer once layered axis materializes.
    voicecli.stt_daemon -> voicecli.daemon_protocol
    # Transitional: voicecli.stt_daemon imports voicecli.transcribe to run STT — coupling is expected but needs STTEnginePort wiring (ADR-003)
    voicecli.stt_daemon -> voicecli.transcribe
    # Transitional: voicecli.model_registry imports voicecli.engine to manage engine instances — needs decoupling via ports layer (ADR-003)
    voicecli.model_registry -> voicecli.engine
    # ADR-003 V10: same top-tier peer dependencies — overlay assembler imports extracted sub-modules
    voicecli.overlay -> voicecli.overlay_audio
    voicecli.overlay -> voicecli.overlay_draw
    voicecli.overlay -> voicecli.stt_client
    # ADR-003 V10: same top-tier peer dependency — cli_dictate uses stt_client for dictate flow
    voicecli.cli_dictate -> voicecli.stt_client
    # ADR-003 V10: same top-tier peer dependency — nats_recorder reuses notify() from stt_client for the
    # progressive "Recording... Ns" bubble emitted from the recorder subprocess.
    voicecli.nats_recorder -> voicecli.stt_client
    # ADR-003 V10: same api package peer dependencies
    voicecli.api.translate -> voicecli.api.engine_caps
    voicecli.api.markdown -> voicecli.api._markdown_directives
    voicecli.history -> voicecli.paths
    # Transitional: engines import Segment/TTSDocument from voicecli.api.markdown — pure data types, moving to
    # a shared primitives layer is tracked by ADR-003; engines need Segment for type-hinted segment iteration
    voicecli.engines.chatterbox -> voicecli.api.markdown
    voicecli.engines.chatterbox_turbo -> voicecli.api.markdown
    voicecli.engines._chatterbox_base -> voicecli.api.markdown
    voicecli.engines.qwen -> voicecli.api.markdown
    voicecli.engines.qwen_fast -> voicecli.api.markdown
    voicecli.engines.voxtral -> voicecli.api.markdown
    # Transitional: daemon_protocol imports Segment from voicecli.api.markdown for protocol encoding
    voicecli.daemon_protocol -> voicecli.api.markdown
    # Transitional: adapters.nats runners call voicecli.api for synthesis/transcription — deferred imports
    # (PLC0415), coupling existed when nats/ was top-tier; to be resolved via ports wiring (ADR-003)
    voicecli.adapters.nats._tts_runner -> voicecli.api
    voicecli.adapters.nats._stt_runner -> voicecli.api

[importlinter:contract:api-no-direct-infra]
name = api must not import daemon or model_registry directly
type = forbidden
source_modules =
    voicecli.api.api
forbidden_modules =
    voicecli.daemon
    voicecli.model_registry
allow_indirect_imports = True
