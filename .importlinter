[importlinter]
root_packages =
    voicecli
include_external_packages = False

# ── Contracts ────────────────────────────────────────────────────────────────

[importlinter:contract:layer-boundaries]
name = Layer dependency rule
type = layers
layers =
    voicecli.cli | voicecli.adapters.nats | voicecli.tg | voicecli.listen | voicecli.overlay
    voicecli.api
    voicecli.engine | voicecli.transcribe | voicecli.daemon | voicecli.stt_daemon | voicecli.model_registry
    voicecli.config | voicecli.paths | voicecli.utils | voicecli.env | voicecli.models | voicecli.samples | voicecli.stt_modes
ignore_imports =
    # Transitional: voicecli.api.translate imports voicecli.utils for shared utilities — api → core cross-tier (top-down)
    voicecli.api.translate -> voicecli.utils
    # Transitional: engines import voicecli.api.markdown for Segment type — upward coupling pending Segment move to core in T6
    voicecli.engines.chatterbox -> voicecli.api.markdown
    voicecli.engines.chatterbox_turbo -> voicecli.api.markdown
    voicecli.engines.qwen -> voicecli.api.markdown
    voicecli.engines.qwen_fast -> voicecli.api.markdown
    voicecli.engines.voxtral -> voicecli.api.markdown
    # Transitional: voicecli.cli imports voicecli.adapters.nats adapters inline for NATS subcommands — needs extraction to adapter layer
    voicecli.cli -> voicecli.adapters.nats.tts_adapter
    voicecli.cli -> voicecli.adapters.nats.config
    voicecli.cli -> voicecli.adapters.nats.stt_adapter
    # Transitional: voicecli.cli imports voicecli.listen for recording subcommand — needs extraction to adapter layer
    voicecli.cli -> voicecli.listen
    # Transitional: voicecli.daemon imports voicecli.engine to load TTS engines — daemon is an infrastructure adapter, coupling is expected but needs SynthesisPort wiring (ADR-059)
    voicecli.daemon -> voicecli.engine
    # Transitional: daemon_protocol is a private helper of daemon — same infrastructure layer, peer import acceptable
    voicecli.daemon -> voicecli.daemon_protocol
    # Transitional: daemon_protocol directly loads engines — covered by the same SynthesisPort ADR-059 wiring work as daemon
    voicecli.daemon_protocol -> voicecli.engine
    # Transitional: voicecli.stt_daemon imports voicecli.transcribe to run STT — coupling is expected but needs STTEnginePort wiring (ADR-059)
    voicecli.stt_daemon -> voicecli.transcribe
    # Transitional: voicecli.model_registry imports voicecli.engine to manage engine instances — needs decoupling via ports layer (ADR-059)
    voicecli.model_registry -> voicecli.engine
