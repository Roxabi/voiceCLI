[importlinter]
root_packages =
    voicecli
include_external_packages = False

[importlinter:contract:layer-boundaries]
name = Layer dependency rule
type = layers
layers =
    voicecli.cli
    voicecli.ui
    voicecli.api
    voicecli.adapters
    voicecli.runtime
    voicecli.engines
    voicecli.ports
    voicecli.core
ignore_imports =
    # ADR-003 V11: runtime.stt_daemon uses ui_sounds; dictation uses clipboard — cross-layer (runtime → ui)
    voicecli.runtime.dictation -> voicecli.ui.clipboard
    voicecli.runtime.stt_daemon -> voicecli.ui.sounds
    # Transitional: engines import Segment/TTSDocument from voicecli.api.markdown — pure data types, moving to
    # a shared primitives layer is tracked by ADR-003; engines need Segment for type-hinted segment iteration
    voicecli.engines.chatterbox -> voicecli.api.markdown
    voicecli.engines.chatterbox_turbo -> voicecli.api.markdown
    voicecli.engines._chatterbox_base -> voicecli.api.markdown
    voicecli.engines.qwen -> voicecli.api.markdown
    voicecli.engines.qwen_fast -> voicecli.api.markdown
    voicecli.engines.voxtral -> voicecli.api.markdown
    # Transitional: wire_protocol imports Segment from voicecli.api.markdown for protocol encoding
    voicecli.runtime.wire_protocol -> voicecli.api.markdown
    # Transitional: NATS runners call voicecli.api for warmup/model loading — adapters below api;
    # to be resolved via warmup port or dependency injection (ADR-003)
    voicecli.adapters.nats._tts_runner -> voicecli.api
    voicecli.adapters.nats._stt_runner -> voicecli.api
    # Transitional: voicecli.ports.stt imports runtime.transcribe directly — needs indirection via port interface (ADR-003)
    voicecli.ports.stt -> voicecli.runtime.transcribe

[importlinter:contract:api-no-direct-infra]
name = api must not import runtime daemon or model_registry directly
type = forbidden
source_modules = voicecli.api
forbidden_modules =
    voicecli.runtime.daemon
    voicecli.runtime.stt_daemon
    voicecli.runtime.model_registry
allow_indirect_imports = True
