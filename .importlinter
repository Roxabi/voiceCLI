[importlinter]
root_packages =
    voicecli
include_external_packages = False

# ── Contracts ────────────────────────────────────────────────────────────────

[importlinter:contract:layer-boundaries]
name = Layer dependency rule
type = layers
layers =
    voicecli.cli | voicecli.cli_samples | voicecli.cli_dictate | voicecli.cli_doctor | voicecli.cli_nats | voicecli.ui | voicecli.runtime.listen
    voicecli.api
    voicecli.adapters
    voicecli.engines.engine | voicecli.runtime.transcribe | voicecli.runtime.daemon | voicecli.runtime.stt_daemon | voicecli.runtime.model_registry | voicecli.runtime.wire_protocol
    voicecli.core
ignore_imports =
    # Transitional: voicecli.api.translate imports voicecli.api.markdown for MD rendering — same api package peer dependency
    voicecli.api.translate -> voicecli.api.markdown
    # Transitional: voicecli.api.translate imports voicecli.core.utils for shared utilities — cross-layer utility dependency
    voicecli.api.translate -> voicecli.core.utils
    # Transitional: voicecli.cli assembler imports extracted sub-app modules — same top-tier peer dependencies (ADR-003 V9)
    voicecli.cli -> voicecli.cli_samples
    voicecli.cli -> voicecli.cli_dictate
    voicecli.cli -> voicecli.cli_doctor
    voicecli.cli -> voicecli.cli_nats
    # Transitional: voicecli.cli_nats imports voicecli.adapters.nats adapters and config — same top-tier peer dependencies (ADR-003 V9)
    voicecli.cli_nats -> voicecli.adapters.nats.config
    voicecli.cli_nats -> voicecli.adapters.nats.tts_adapter
    voicecli.cli_nats -> voicecli.adapters.nats.stt_adapter
    # Transitional: voicecli.cli_nats configures model_registry at startup — pending ports-layer wiring (ADR-003)
    voicecli.cli_nats -> voicecli.runtime.model_registry
    # Transitional: voicecli.cli imports voicecli.runtime.listen for recording subcommand — needs extraction to adapter layer
    voicecli.cli -> voicecli.runtime.listen
    # Transitional: voicecli.runtime.daemon imports voicecli.engines.engine to load TTS engines — daemon is an infrastructure adapter, coupling is expected but needs SynthesisPort wiring (ADR-003)
    voicecli.runtime.daemon -> voicecli.engines.engine
    # Transitional: wire_protocol is a private helper of daemon — same infrastructure layer, peer import acceptable
    voicecli.runtime.daemon -> voicecli.runtime.wire_protocol
    # Transitional: wire_protocol directly loads engines — covered by the same SynthesisPort ADR-003 wiring work as daemon
    voicecli.runtime.wire_protocol -> voicecli.engines.engine
    # Transitional: wire_protocol is shared wire-encoding between TTS/STT daemons (audit #162). Per ADR-003 debt #4, extract to voicecli.wire_protocol under the ports layer once layered axis materializes.
    voicecli.runtime.stt_daemon -> voicecli.runtime.wire_protocol
    # Transitional: voicecli.runtime.stt_daemon imports voicecli.runtime.transcribe to run STT — coupling is expected but needs STTEnginePort wiring (ADR-003)
    voicecli.runtime.stt_daemon -> voicecli.runtime.transcribe
    # Transitional: voicecli.runtime.model_registry imports voicecli.engines.engine to manage engine instances — needs decoupling via ports layer (ADR-003)
    voicecli.runtime.model_registry -> voicecli.engines.engine
    # ADR-003 V11: ui/ sub-package — overlay assembler imports extracted sub-modules (same ui package peers)
    voicecli.ui.overlay -> voicecli.ui.overlay_audio
    voicecli.ui.overlay -> voicecli.ui.overlay_draw
    voicecli.ui.overlay -> voicecli.ui.stt_client
    # ADR-003 V11: cli_dictate uses stt_client for dictate flow — cross-layer (cli → ui)
    voicecli.cli_dictate -> voicecli.ui.stt_client
    voicecli.cli_dictate -> voicecli.ui.clipboard
    voicecli.cli_dictate -> voicecli.ui.nats_recorder
    voicecli.cli_dictate -> voicecli.ui.sounds
    # ADR-003 V11: nats_recorder reuses notify() from stt_client (same ui package peer)
    voicecli.ui.nats_recorder -> voicecli.ui.stt_client
    # ADR-003 V11: runtime.stt_daemon uses clipboard and ui_sounds — cross-layer (runtime → ui)
    voicecli.runtime.stt_daemon -> voicecli.ui.clipboard
    voicecli.runtime.stt_daemon -> voicecli.ui.sounds
    # ADR-003 V10: same api package peer dependencies
    voicecli.api.translate -> voicecli.api.engine_caps
    voicecli.api.markdown -> voicecli.api._markdown_directives
    voicecli.core.history -> voicecli.core.paths
    # Transitional: engines import Segment/TTSDocument from voicecli.api.markdown — pure data types, moving to
    # a shared primitives layer is tracked by ADR-003; engines need Segment for type-hinted segment iteration
    voicecli.engines.chatterbox -> voicecli.api.markdown
    voicecli.engines.chatterbox_turbo -> voicecli.api.markdown
    voicecli.engines._chatterbox_base -> voicecli.api.markdown
    voicecli.engines.qwen -> voicecli.api.markdown
    voicecli.engines.qwen_fast -> voicecli.api.markdown
    voicecli.engines.voxtral -> voicecli.api.markdown
    # Transitional: wire_protocol imports Segment from voicecli.api.markdown for protocol encoding
    voicecli.runtime.wire_protocol -> voicecli.api.markdown
    # Transitional: adapters.nats runners call voicecli.api for synthesis/transcription — deferred imports
    # (PLC0415), coupling existed when nats/ was top-tier; to be resolved via ports wiring (ADR-003)
    voicecli.adapters.nats._tts_runner -> voicecli.api
    voicecli.adapters.nats._stt_runner -> voicecli.api

[importlinter:contract:api-no-direct-infra]
name = api must not import daemon or model_registry directly
type = forbidden
source_modules =
    voicecli.api.api
forbidden_modules =
    voicecli.runtime.daemon
    voicecli.runtime.model_registry
allow_indirect_imports = True
