[importlinter]
root_packages =
    voicecli
include_external_packages = False

# ── Contracts ────────────────────────────────────────────────────────────────

[importlinter:contract:layer-boundaries]
name = Layer dependency rule
type = layers
layers =
    voicecli.cli | voicecli.adapters.nats | voicecli.tg | voicecli.runtime.listen | voicecli.overlay
    voicecli.api
    voicecli.engines.engine | voicecli.runtime.transcribe | voicecli.runtime.daemon | voicecli.runtime.stt_daemon | voicecli.runtime.model_registry
    voicecli.config | voicecli.paths | voicecli.utils | voicecli.env | voicecli.models | voicecli.samples | voicecli.stt_modes
ignore_imports =
    # Transitional: voicecli.api.translate imports voicecli.utils for shared utilities — api → core cross-tier (top-down)
    voicecli.api.translate -> voicecli.utils
    # Transitional: engines import voicecli.api.markdown for Segment type — upward coupling pending Segment move to core in T6
    voicecli.engines.chatterbox -> voicecli.api.markdown
    voicecli.engines.chatterbox_turbo -> voicecli.api.markdown
    voicecli.engines.qwen -> voicecli.api.markdown
    voicecli.engines.qwen_fast -> voicecli.api.markdown
    voicecli.engines.voxtral -> voicecli.api.markdown
    # Transitional: wire_protocol imports voicecli.api.markdown for Segment type — same upward coupling, resolved when Segment moves to core in T6
    voicecli.runtime.wire_protocol -> voicecli.api.markdown
    # Transitional: voicecli.cli imports voicecli.adapters.nats adapters inline for NATS subcommands — needs extraction to adapter layer
    voicecli.cli -> voicecli.adapters.nats.tts_adapter
    voicecli.cli -> voicecli.adapters.nats.config
    voicecli.cli -> voicecli.adapters.nats.stt_adapter
    # Transitional: voicecli.cli imports voicecli.runtime.listen for recording subcommand — needs extraction to adapter layer
    voicecli.cli -> voicecli.runtime.listen
    # Transitional: voicecli.runtime.daemon imports voicecli.engines.engine to load TTS engines — daemon is an infrastructure adapter, coupling is expected but needs SynthesisPort wiring (ADR-059)
    voicecli.runtime.daemon -> voicecli.engines.engine
    # Transitional: wire_protocol directly loads engines — covered by the same SynthesisPort ADR-059 wiring work as daemon
    voicecli.runtime.wire_protocol -> voicecli.engines.engine
    # Transitional: voicecli.runtime.stt_daemon imports voicecli.runtime.transcribe to run STT — coupling is expected but needs STTEnginePort wiring (ADR-059)
    voicecli.runtime.stt_daemon -> voicecli.runtime.transcribe
    # Transitional: voicecli.runtime.model_registry imports voicecli.engines.engine to manage engine instances — needs decoupling via ports layer (ADR-059)
    voicecli.runtime.model_registry -> voicecli.engines.engine
